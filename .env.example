# Application name (emails, logs)
APP_NAME=Echo
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/loom
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# AWS S3 (private bucket). Put your own keys here — this file is git-ignored; never commit it or send it to the browser.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PREFIX=uploads
MAX_UPLOAD_MB=100

# Public URL of the web app (used in the verification link emailed to users)
CLIENT_URL=http://localhost:5173

# ZeptoMail (https://www.zoho.com/zeptomail/) — Mail Agent > SMTP/API > "Send Mail Token".
# Use the host for your data centre: api.zeptomail.com (US), api.zeptomail.in (India), api.zeptomail.eu (EU), api.zeptomail.com.au ...
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_HOST=api.zeptomail.com
# Must be an address on a domain you verified in ZeptoMail
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME=Echo

# Public logo URL for emails (see README: S3 public read for uploads/brand/*). Falls back to a text badge if unreachable.
MAIL_LOGO_URL=

# Admin panel — first admin is created automatically when there is none (password >= 10 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional: separate signing secret for admin tokens (defaults to JWT_SECRET + ':admin')
ADMIN_JWT_SECRET=

# How long (minutes) after sending a user may delete their own message for everyone. 0 = no limit. "Delete for me" has no limit.
MESSAGE_DELETE_WINDOW_MINUTES=30
